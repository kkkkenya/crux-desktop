	"license": "AGPL-3.0-only",
	"author": {
		"name": "Engineering Study Hub"
	},
	"contributors": [
		{
			"name": "Amos Blomqvist and the LearnHarness contributors",
			"url": "https://github.com/amosblomqvist/learnharness"
		}
